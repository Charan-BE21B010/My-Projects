# Optional: at least one LLM key unlocks better extraction and ranking.
# Without a key the engine still runs using search + heuristic scoring.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Preferred provider when both keys are present: openai | gemini | auto
LLM_PROVIDER=auto

# Soft cap on outbound HTTP requests during enrichment
MAX_ENRICH_REQUESTS=20
REQUEST_TIMEOUT_SECONDS=20